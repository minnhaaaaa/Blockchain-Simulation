{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:agentguard:schema:job-create-request:1",
  "title": "Create job request",
  "type": "object",
  "additionalProperties": false,
  "required": ["title", "instructions", "provider_id", "input_artifact_ids", "policy"],
  "properties": {
    "title": {"type": "string", "minLength": 1, "maxLength": 160},
    "instructions": {"type": "string", "minLength": 1, "maxLength": 20000},
    "provider_id": {"type": "string", "minLength": 1, "maxLength": 128},
    "input_artifact_ids": {
      "type": "array",
      "uniqueItems": true,
      "items": {"$ref": "./common.schema.json#/$defs/artifactId"}
    },
    "policy": {
      "type": "object",
      "additionalProperties": false,
      "required": ["rules", "limits"],
      "properties": {
        "rules": {
          "type": "array",
          "minItems": 1,
          "items": {"$ref": "./policy.schema.json#/$defs/ruleInput"}
        },
        "limits": {"$ref": "./policy.schema.json#/$defs/limits"},
        "expires_at_ms": {
          "oneOf": [
            {"$ref": "./common.schema.json#/$defs/timestampMs"},
            {"type": "null"}
          ]
        }
      }
    }
  }
}
