{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:agentguard:schema:room-join:1",
  "title": "Room join request",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "node_id",
    "name",
    "advertised_host",
    "advertised_port",
    "public_key_fingerprint"
  ],
  "properties": {
    "schema_version": {"const": 1},
    "node_id": {"$ref": "./common.schema.json#/$defs/nodeId"},
    "name": {"type": "string", "minLength": 1, "maxLength": 80},
    "advertised_host": {"type": "string", "minLength": 1, "maxLength": 255},
    "advertised_port": {"type": "integer", "minimum": 1, "maximum": 65535},
    "public_key_fingerprint": {"$ref": "./common.schema.json#/$defs/sha256"}
  }
}
