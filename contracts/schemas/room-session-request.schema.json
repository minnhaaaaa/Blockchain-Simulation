{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:agentguard:schema:room-session-request:1",
  "title": "Application room session request",
  "type": "object",
  "additionalProperties": false,
  "required": ["operation", "room_id"],
  "properties": {
    "operation": {"enum": ["create", "join"]},
    "room_id": {"$ref": "./common.schema.json#/$defs/roomId"},
    "protocol_version": {"type": "string", "minLength": 1, "maxLength": 32},
    "consensus_parameters": {
      "$ref": "./room-manifest.schema.json#/$defs/consensusParameters"
    },
    "genesis_allocations": {
      "type": "array",
      "minItems": 1,
      "items": {"$ref": "./room-manifest.schema.json#/$defs/genesisAllocation"}
    }
  },
  "allOf": [
    {
      "if": {"properties": {"operation": {"const": "create"}}},
      "then": {
        "required": ["protocol_version", "consensus_parameters", "genesis_allocations"]
      }
    },
    {
      "if": {"properties": {"operation": {"const": "join"}}},
      "then": {
        "not": {
          "anyOf": [
            {"required": ["protocol_version"]},
            {"required": ["consensus_parameters"]},
            {"required": ["genesis_allocations"]}
          ]
        }
      }
    }
  ]
}
