{
  "name": "agentguard-console",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "npm run generate:types && tsc -b && vite build",
    "preview": "vite preview",
    "generate:types": "openapi-typescript ../contracts/openapi.json -o src/types/openapi.ts",
    "check:generated": "npm run generate:types && git diff --exit-code -- src/types/openapi.ts",
    "typecheck": "tsc --noEmit -p tsconfig.app.json",
    "lint": "eslint .",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "test:e2e:ui": "playwright test --ui",
    "demo": "node ../scripts/demo.mjs",
    "check": "npm run generate:types && npm run typecheck && npm run lint && npm run test && npm run build"
  },
  "dependencies": {
    "@fontsource/ibm-plex-mono": "5.3.0",
    "@fontsource/manrope": "5.3.0",
    "@gsap/react": "2.1.2",
    "@radix-ui/react-select": "^2.3.7",
    "@tanstack/react-query": "5.104.0",
    "ajv": "8.20.0",
    "framer-motion": "^13.4.6",
    "gsap": "3.15.0",
    "lucide-react": "1.48.0",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "react-markdown": "^10.1.0",
    "react-router-dom": "7.18.4",
    "remark-gfm": "^4.0.1",
    "three": "^0.186.1"
  },
  "devDependencies": {
    "@eslint/js": "9.39.3",
    "@playwright/test": "1.63.0",
    "@testing-library/jest-dom": "7.0.1",
    "@testing-library/react": "16.3.3",
    "@testing-library/user-event": "14.6.7",
    "@types/node": "24.5.2",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@types/three": "^0.186.0",
    "@vitejs/plugin-react": "6.1.1",
    "eslint": "9.39.3",
    "jsdom": "29.0.1",
    "openapi-typescript": "7.13.0",
    "typescript": "5.9.3",
    "typescript-eslint": "8.71.0",
    "vite": "8.3.1",
    "vitest": "5.0.2"
  }
}
